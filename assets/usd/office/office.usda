#usda 1.0
(
    defaultPrim = "World"
    doc = """Aethel canonical office stage — USD scene with physics metadata.

This is the root OpenUSD layer for the Aethel office environment.  It
composes reusable prop assets from assets/usd/office/props/ into a single
scene hierarchy and defines the authoritative prim structure, coordinate
conventions, camera, and baseline lighting.

Each prop is defined in its own file under props/ and referenced here
as a payload so the stage can be opened without loading all geometry.

Physics metadata is embedded in each prop USDA file using:
  - Standard USD Physics API schemas (PhysicsCollisionAPI, PhysicsRigidBodyAPI)
  - Custom metadata fields in the customData dictionary (see PHYSICS_METADATA.md)

Coordinate conventions
----------------------
  upAxis        : Y  (Y-up, consistent with GLB / Three.js web runtime)
  metersPerUnit : 1  (all translations and bounding-box extents are in metres)
  Handedness    : right-handed (USD default)

  To use in a Y-up GLB / Three.js web scene no rotation is needed.
  To use in a Z-up DCC (e.g. Blender default scene): apply a -90° X rotation
  at import, or configure Blender's USD import to convert up-axis.

Props:
  Furniture (static):
    /World/Office/OfficeDeskRoot     — office-desk
    /World/Office/OfficeChairRoot    — office-chair
    /World/Office/OfficeDeskLampRoot — office-desk-lamp
  Devices:
    /World/Office/OfficeMonitorRoot  — office-monitor  (static)
    /World/Office/OfficeLaptopRoot   — office-laptop   (dynamic, 2.0 kg)
    /World/Office/OfficeKeyboardRoot — office-keyboard (dynamic, 0.5 kg)
  Containers:
    /World/Office/OfficeTrashCanRoot — office-trash-can (dynamic, 1.5 kg)
  Clutter/accessories (dynamic):
    /World/Office/OfficeBookStackRoot  — office-book-stack  (0.8 kg)
    /World/Office/OfficeCoffeeCupRoot  — office-coffee-cup  (0.3 kg, restitution=0.1)
    /World/Office/OfficeNotebookRoot   — office-notebook    (0.2 kg)

Source & license
----------------
  All props trace back to CC0-licensed free asset packs.  Full provenance
  is recorded in assets/sources/office/manifest.json and each prop's
  customData aethel dictionary.

Validation:
  Run 'make assets-validate' to confirm all required props have physics metadata.
  The validator parses each USDA file and checks customData fields and apiSchemas.

Adding a new prop
-----------------
  1. Add a source entry to assets/sources/office/manifest.json.
  2. Create a prop USDA under assets/usd/office/props/.
  3. Add a reference under the appropriate /World/Office/* scope below.
  4. Run make test to verify the drift-detection tests still pass.
"""
    metersPerUnit = 1
    upAxis = "Y"
)

# ============================================================
#  World root
# ============================================================
def Xform "World" (
    doc = "Root world scope for the Aethel office scene."
    customData = {
        dictionary aethel = {
            string sceneId = "office"
            string version = "0.2.0"
            string manifestRef = "assets/sources/office/manifest.json"
        }
    }
)
{
    # --------------------------------------------------------
    #  Office scope — contains all in-scene objects
    # --------------------------------------------------------
    def Xform "Office" (
        doc = "Top-level container for all office objects."
    )
    {
        # ---- Furniture (static) ----------------------------

        # Desk (static, box collider)
        def "OfficeDeskRoot" (
            doc = "Office desk. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-desk.usda@</OfficeDeskRoot>
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # Chair (static, box collider)
        def "OfficeChairRoot" (
            doc = "Office chair. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-chair.usda@</OfficeChairRoot>
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.9)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # Desk Lamp (static, convexHull collider)
        def "OfficeDeskLampRoot" (
            doc = "Desk lamp. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-desk-lamp.usda@</OfficeDeskLampRoot>
        )
        {
            double3 xformOp:translate = (0.55, 0.76, -0.24)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # ---- Devices ---------------------------------------

        # Monitor (static, box collider)
        def "OfficeMonitorRoot" (
            doc = "Wide monitor / screen. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-monitor.usda@</OfficeMonitorRoot>
        )
        {
            double3 xformOp:translate = (0.1, 0.76, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # Laptop (dynamic, box collider, 2.0 kg)
        def "OfficeLaptopRoot" (
            doc = "Laptop computer. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-laptop.usda@</OfficeLaptopRoot>
        )
        {
            double3 xformOp:translate = (-0.43, 0.76, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # Keyboard (dynamic, box collider, 0.5 kg)
        def "OfficeKeyboardRoot" (
            doc = "Keyboard. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-keyboard.usda@</OfficeKeyboardRoot>
        )
        {
            double3 xformOp:translate = (0.0, 0.76, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # ---- Containers ------------------------------------

        # Trash Can (dynamic, cylinder collider, 1.5 kg)
        def "OfficeTrashCanRoot" (
            doc = "Waste bin. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-trash-can.usda@</OfficeTrashCanRoot>
        )
        {
            double3 xformOp:translate = (1.05, 0.0, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # ---- Clutter / accessories -------------------------

        # Book Stack (dynamic, box collider, 0.8 kg)
        def "OfficeBookStackRoot" (
            doc = "Book stack. Source: Kenney Furniture Kit (CC0-1.0)."
            prepend payload = @./props/office-book-stack.usda@</OfficeBookStackRoot>
        )
        {
            double3 xformOp:translate = (0.42, 0.76, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # Coffee Cup (dynamic, cylinder collider, 0.3 kg, restitution=0.1)
        def "OfficeCoffeeCupRoot" (
            doc = "Coffee mug. Source: Aethel Generated Office Props (CC0-1.0)."
            prepend payload = @./props/office-coffee-cup.usda@</OfficeCoffeeCupRoot>
        )
        {
            double3 xformOp:translate = (-0.58, 0.76, -0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # Notebook (dynamic, box collider, 0.2 kg)
        def "OfficeNotebookRoot" (
            doc = "Spiral notebook. Source: Aethel Generated Office Props (CC0-1.0)."
            prepend payload = @./props/office-notebook.usda@</OfficeNotebookRoot>
        )
        {
            double3 xformOp:translate = (0.48, 0.76, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    # --------------------------------------------------------
    #  Lights
    # --------------------------------------------------------
    def Xform "Lights" (
        doc = "Scene lights for the office environment."
    )
    {
        # Ambient dome light — soft neutral fill from all directions.
        def DomeLight "AmbientDome" (
            doc = "Ambient dome light providing soft neutral fill illumination."
        )
        {
            float inputs:intensity = 0.6
            color3f inputs:color = (1, 1, 1)
            token texture:format = "latlong"
        }

        # Key light — simulates a window or ceiling fixture from upper-right.
        def DistantLight "KeyLight" (
            doc = "Directional key light simulating a ceiling fixture from upper-right."
        )
        {
            float inputs:intensity = 2500
            color3f inputs:color = (1, 0.98, 0.92)
            float3 xformOp:rotateXYZ = (-55, 40, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        # Fill light — softer light from the opposite side to reduce harsh shadows.
        def DistantLight "FillLight" (
            doc = "Softer fill light from upper-left to reduce harsh shadows."
        )
        {
            float inputs:intensity = 800
            color3f inputs:color = (0.9, 0.95, 1)
            float3 xformOp:rotateXYZ = (-30, -60, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    # --------------------------------------------------------
    #  Cameras
    # --------------------------------------------------------
    def Xform "Cameras" (
        doc = "Scene cameras for the office environment."
    )
    {
        # Default camera: positioned to frame the desk area from a natural
        # human-eye viewpoint — approximately 1.7 m high, 1.5 m back, and
        # slightly to the right and above to capture the desk, monitor, and chair.
        #
        # Framing: matches the MVP web viewport perspective so the USD camera
        # can be used as a reference when adjusting the Three.js camera.
        #
        # focalLength / aperture: ~50 mm equivalent on a 35 mm sensor.
        def Camera "OfficeCamera" (
            doc = "Default office camera.  Y-up perspective, 50 mm equivalent, framing the desk."
        )
        {
            float2 clippingRange = (0.01, 100)
            float focalLength = 50
            float horizontalAperture = 20.955
            float verticalAperture = 15.2908
            token projection = "perspective"
            double3 xformOp:translate = (1.5, 1.7, 2.5)
            float3 xformOp:rotateXYZ = (-18, 25, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }
}
