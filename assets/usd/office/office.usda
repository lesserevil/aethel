#usda 1.0
(
    defaultPrim = "World"
    doc = """Aethel canonical office stage — USD scene with physics metadata.

This is the root OpenUSD layer for the Aethel office environment.  It
composes reusable prop assets from assets/usd/office/props/ into a single
scene hierarchy and defines the authoritative prim structure, coordinate
conventions, camera, and baseline lighting.

Each prop is defined in its own file under props/ and referenced here
as a payload so the stage can be opened without loading all geometry.

Physics metadata is embedded in each prop USDA file using:
  - Standard USD Physics API schemas (PhysicsCollisionAPI, PhysicsRigidBodyAPI)
  - Custom metadata fields in the customData dictionary (see PHYSICS_METADATA.md)

Coordinate conventions
----------------------
  upAxis        : Y  (Y-up, consistent with GLB / Three.js web runtime)
  metersPerUnit : 1  (all translations and bounding-box extents are in metres)
  Handedness    : right-handed (USD default)

  To use in a Y-up GLB / Three.js web scene no rotation is needed.
  To use in a Z-up DCC (e.g. Blender default scene): apply a -90° X rotation
  at import, or configure Blender's USD import to convert up-axis.

Scene hierarchy
---------------
  /World/Office/Architecture    — room shell and floor plane
  /World/Office/Furniture/      — static and semi-static furniture
    Desk, DeskChair, LampDesk
  /World/Office/Devices/        — electronics (monitors, laptop, keyboard)
    MonitorWide, Laptop, Keyboard
  /World/Office/Containers/     — bins and storage
    TrashCan
  /World/Office/Clutter/        — small dynamic props
    Mug, Book, Notebook
  /World/Lights/                — lighting rigs
  /World/Cameras/               — scene cameras

Source & license
----------------
  All props trace back to CC0-licensed free asset packs.  Full provenance
  is recorded in assets/sources/office/manifest.json and each prop's
  customData aethel dictionary.

Validation:
  Run 'make assets-validate' to confirm all required props have physics metadata.
  The validator parses each USDA file and checks customData fields and apiSchemas.

Adding a new prop
-----------------
  1. Add a source entry to assets/sources/office/manifest.json.
  2. Create a prop USDA under assets/usd/office/props/.
  3. Add a reference under the appropriate /World/Office/* scope below.
  4. Run make test to verify the drift-detection tests still pass.
"""
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World" (
    doc = "Scene root — Y-up, metres."
)
{
    # --------------------------------------------------------
    #  Office environment
    # --------------------------------------------------------
    def Xform "Office" (
        doc = "Office environment scope."
    )
    {
        # ---- Architecture ----------------------------------
        # Placeholder for room shell geometry (walls, floor, ceiling).
        # Not yet populated — add room meshes here when available.
        def Xform "Architecture" (
            doc = "Room shell: walls, floor, ceiling. Placeholder — geometry to be added."
        )
        {
        }

        # ---- Furniture (static) ----------------------------
        def Xform "Furniture" (
            doc = "Static and semi-static office furniture."
        )
        {
            def Xform "Desk" (
                doc = "Office desk. Source: Kenney Furniture Kit (CC0-1.0)."
                prepend references = @./props/desk.usda@</Desk>
            )
            {
            }

            def Xform "DeskChair" (
                doc = "Office chair. Source: Kenney Furniture Kit (CC0-1.0)."
                prepend references = @./props/desk_chair.usda@</DeskChair>
            )
            {
            }

            def Xform "LampDesk" (
                doc = "Desk lamp. Source: Kenney Furniture Kit (CC0-1.0)."
                prepend references = @./props/lamp_desk.usda@</LampDesk>
            )
            {
            }
        }

        # ---- Devices ---------------------------------------
        def Xform "Devices" (
            doc = "Electronic devices: monitors, laptop, keyboard."
        )
        {
            def Xform "MonitorWide" (
                doc = "Wide monitor / screen. Source: Kenney Furniture Kit (CC0-1.0)."
                prepend references = @./props/monitor_wide.usda@</MonitorWide>
            )
            {
            }

            def Xform "Laptop" (
                doc = "Laptop computer. Source: Kenney Furniture Kit (CC0-1.0)."
                prepend references = @./props/laptop.usda@</Laptop>
            )
            {
            }

            def Xform "Keyboard" (
                doc = "Keyboard. Source: Kenney Furniture Kit (CC0-1.0)."
                prepend references = @./props/keyboard.usda@</Keyboard>
            )
            {
            }
        }

        # ---- Containers ------------------------------------
        def Xform "Containers" (
            doc = "Bins, boxes, and storage containers."
        )
        {
            def Xform "TrashCan" (
                doc = "Waste bin. Source: Kenney Furniture Kit (CC0-1.0)."
                prepend references = @./props/trash_can.usda@</TrashCan>
            )
            {
            }
        }

        # ---- Clutter / accessories -------------------------
        def Xform "Clutter" (
            doc = "Small dynamic props: mugs, books, notebooks."
        )
        {
            def Xform "Mug" (
                doc = "Coffee mug / cup. Source: Eclair Home Desk Props (CC0-1.0)."
                prepend references = @./props/mug.usda@</Mug>
            )
            {
            }

            def Xform "Book" (
                doc = "Book / book stack. Source: Eclair Home Desk Props (CC0-1.0)."
                prepend references = @./props/book.usda@</Book>
            )
            {
            }

            def Xform "Notebook" (
                doc = "Spiral notebook. Source: Eclair Home Desk Props (CC0-1.0)."
                prepend references = @./props/notebook.usda@</Notebook>
            )
            {
            }
        }
    }

    # --------------------------------------------------------
    #  Lights
    # --------------------------------------------------------
    def Xform "Lights" (
        doc = "Scene lighting rig."
    )
    {
        # Ambient dome — fills the scene with a neutral daylight tone.
        def DomeLight "AmbientDome" (
            doc = "Ambient dome light — neutral daylight fill."
        )
        {
            float inputs:intensity = 400
            color3f inputs:color = (1, 1, 1)
        }

        # Key light — warm directional light from upper-right.
        def DistantLight "KeyLight" (
            doc = "Key light — warm directional from upper-right."
        )
        {
            float inputs:intensity = 2500
            color3f inputs:color = (1, 0.98, 0.92)
            float3 xformOp:rotateXYZ = (-55, 40, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        # Fill light — softer light from the opposite side to reduce harsh shadows.
        def DistantLight "FillLight" (
            doc = "Softer fill light from upper-left to reduce harsh shadows."
        )
        {
            float inputs:intensity = 800
            color3f inputs:color = (0.9, 0.95, 1)
            float3 xformOp:rotateXYZ = (-30, -60, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    # --------------------------------------------------------
    #  Cameras
    # --------------------------------------------------------
    def Xform "Cameras" (
        doc = "Scene cameras for the office environment."
    )
    {
        # Default camera: positioned to frame the desk area from a natural
        # human-eye viewpoint — approximately 1.7 m high, 1.5 m back, and
        # slightly to the right and above to capture the desk, monitor, and chair.
        #
        # Framing: matches the MVP web viewport perspective so the USD camera
        # can be used as a reference when adjusting the Three.js camera.
        #
        # focalLength / aperture: ~50 mm equivalent on a 35 mm sensor.
        def Camera "OfficeCamera" (
            doc = "Default office camera.  Y-up perspective, 50 mm equivalent, framing the desk."
        )
        {
            float2 clippingRange = (0.01, 100)
            float focalLength = 50
            float horizontalAperture = 20.955
            float verticalAperture = 15.2908
            token projection = "perspective"
            double3 xformOp:translate = (1.5, 1.7, 2.5)
            float3 xformOp:rotateXYZ = (-18, 25, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }
}
