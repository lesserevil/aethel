#usda 1.0
(
    defaultPrim = "OfficeLaptopRoot"
    doc = """Office prop: Laptop
    
    USD Physics metadata for a dynamic portable laptop computer.
    Body type: dynamic (small device — fully simulated by physics engine).
    Collision shape: box approximation (separate from render mesh).
    Render mesh: loaded at runtime from /assets/office/office-laptop.glb.
    
    Custom metadata fields are documented in assets/usd/PHYSICS_METADATA.md.
    """
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "OfficeLaptopRoot" (
    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    customData = {
        string physicsBodyType = "dynamic"
        string physicsColliderType = "box"
        float3 physicsDimensions = (0.35, 0.22, 0.32)
        string semanticLabel = "portable laptop computer"
        string assetId = "office-laptop"
        string sourceId = "kenney-furniture-kit"
        string sourceUrl = "https://poly.pizza/bundle/Furniture-Kit-NoG1sEUD1z"
        string licenseId = "cc0-1.0"
        string licenseUrl = "https://creativecommons.org/publicdomain/zero/1.0/"
        string usdPrimPath = "/World/Office/OfficeLaptopRoot"
        string category = "device"
        bool agentSafe = true
        string[] affordances = ["input-device", "pickup"]
        float physicsMassKg = 2.0
        float physicsFriction = 0.5
    }
)
{
    # Box collision primitive — separate from the render mesh.
    # Scale: 0.35m x 0.22m x 0.32m (width x height x depth).
    # The open-lid profile matches the committed Kenney laptop runtime GLB.
    def Cube "ColliderBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
        doc = "Box collider for office-laptop: width=0.35m height=0.22m depth=0.32m"
    )
    {
        double3 xformOp:scale = (0.35, 0.22, 0.32)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Xform "RenderMeshPlaceholder" (
        doc = "Render geometry loaded from office-laptop.glb — NOT used as collision mesh"
    )
    {
    }
}
