#usda 1.0
(
    defaultPrim = "OfficeBookStackRoot"
    doc = """Office prop: Book Stack
    
    USD Physics metadata for a dynamic stack of books (clutter/accessory).
    Body type: dynamic (small clutter — fully simulated by physics engine).
    Collision shape: box approximation (separate from render mesh).
    Render mesh: loaded at runtime from /assets/office/office-book-stack.glb.
    
    Custom metadata fields are documented in assets/usd/PHYSICS_METADATA.md.
    """
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "OfficeBookStackRoot" (
    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    customData = {
        string physicsBodyType = "dynamic"
        string physicsColliderType = "box"
        float3 physicsDimensions = (0.15, 0.2, 0.1)
        string semanticLabel = "small stack of books on the desk"
        string assetId = "office-book-stack"
        string sourceId = "kenney-furniture-kit"
        string sourceUrl = "https://poly.pizza/bundle/Furniture-Kit-NoG1sEUD1z"
        string licenseId = "cc0-1.0"
        string licenseUrl = "https://creativecommons.org/publicdomain/zero/1.0/"
        string usdPrimPath = "/World/Office/OfficeBookStackRoot"
        string category = "clutter"
        bool agentSafe = true
        string[] affordances = ["pickup"]
        float physicsMassKg = 0.8
        float physicsFriction = 0.5
    }
)
{
    # Box collision primitive — separate from the render mesh.
    # Scale: 0.15m x 0.2m x 0.1m (width x height x depth).
    def Cube "ColliderBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
        doc = "Box collider for office-book-stack: width=0.15m height=0.2m depth=0.1m"
    )
    {
        double3 xformOp:scale = (0.15, 0.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Xform "RenderMeshPlaceholder" (
        doc = "Render geometry loaded from office-book-stack.glb — NOT used as collision mesh"
    )
    {
    }
}
