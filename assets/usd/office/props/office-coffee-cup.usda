#usda 1.0
(
    doc = """Office prop: Coffee Cup
    
    USD Physics metadata for a dynamic ceramic coffee cup (clutter/accessory).
    Body type: dynamic (small clutter — fully simulated by physics engine).
    Collision shape: cylinder approximation (separate from render mesh).
    Render mesh: loaded at runtime from /assets/office/office-coffee-cup.glb.
    
    Custom metadata fields are documented in assets/usd/PHYSICS_METADATA.md.
    """
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "OfficeCoffeeCupRoot" (
    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    customData = {
        string physicsBodyType = "dynamic"
        string physicsColliderType = "cylinder"
        float3 physicsDimensions = (0.08, 0.1, 0.08)
        string semanticLabel = "ceramic coffee cup on the desk"
        string assetId = "office-coffee-cup"
        string category = "clutter"
        bool agentSafe = true
        string[] affordances = ["containable", "pickup"]
        float physicsMassKg = 0.3
        float physicsFriction = 0.4
        float physicsRestitution = 0.1
    }
)
{
    # Cylinder collision primitive — separate from the render mesh.
    # Diameter: 0.08m → radius = 0.04m. Height: 0.1m.
    # A cylinder is a better approximation for a round cup than a box.
    def Cylinder "ColliderCylinder" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
        doc = "Cylinder collider for office-coffee-cup: radius=0.04m height=0.1m"
    )
    {
        double height = 0.1
        double radius = 0.04
    }

    def Xform "RenderMeshPlaceholder" (
        doc = "Render geometry loaded from office-coffee-cup.glb — NOT used as collision mesh"
    )
    {
    }
}
