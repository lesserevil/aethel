#usda 1.0
(
    doc = """Office prop: Keyboard
    
    USD Physics metadata for a dynamic full-size computer keyboard.
    Body type: dynamic (small device — fully simulated by physics engine).
    Collision shape: box approximation (separate from render mesh).
    Render mesh: loaded at runtime from /assets/office/office-keyboard.glb.
    
    Custom metadata fields are documented in assets/usd/PHYSICS_METADATA.md.
    """
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "OfficeKeyboardRoot" (
    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    customData = {
        string physicsBodyType = "dynamic"
        string physicsColliderType = "box"
        float3 physicsDimensions = (0.45, 0.03, 0.15)
        string semanticLabel = "full-size computer keyboard for text input"
        string assetId = "office-keyboard"
        string category = "device"
        bool agentSafe = true
        string[] affordances = ["input-device", "pickup"]
        float physicsMassKg = 0.5
        float physicsFriction = 0.6
    }
)
{
    # Box collision primitive — separate from the render mesh.
    # Scale: 0.45m x 0.03m x 0.15m (width x height x depth).
    def Cube "ColliderBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
        doc = "Box collider for office-keyboard: width=0.45m height=0.03m depth=0.15m"
    )
    {
        double3 xformOp:scale = (0.45, 0.03, 0.15)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Xform "RenderMeshPlaceholder" (
        doc = "Render geometry loaded from office-keyboard.glb — NOT used as collision mesh"
    )
    {
    }
}
