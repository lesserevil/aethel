#usda 1.0
(
    defaultPrim = "OfficeChairRoot"
    doc = """Office prop: Office Chair
    
    USD Physics metadata for a static ergonomic office chair.
    Body type: static (heavy furniture — does not move under physics forces).
    Collision shape: box approximation (separate from render mesh).
    Render mesh: loaded at runtime from /assets/office/office-chair.glb.
    
    Custom metadata fields are documented in assets/usd/PHYSICS_METADATA.md.
    """
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "OfficeChairRoot" (
    prepend apiSchemas = ["PhysicsCollisionAPI"]
    customData = {
        string physicsBodyType = "static"
        string physicsColliderType = "box"
        float3 physicsDimensions = (0.6, 0.9, 0.6)
        string semanticLabel = "ergonomic office chair with a padded seat"
        string assetId = "office-chair"
        string sourceId = "kenney-furniture-kit"
        string sourceUrl = "https://poly.pizza/bundle/Furniture-Kit-NoG1sEUD1z"
        string licenseId = "cc0-1.0"
        string licenseUrl = "https://creativecommons.org/publicdomain/zero/1.0/"
        string usdPrimPath = "/World/Office/OfficeChairRoot"
        string category = "furniture"
        bool agentSafe = false
        string[] affordances = ["seatable"]
    }
)
{
    # Box collision primitive — separate from the render mesh.
    # Scale: 0.6m x 0.9m x 0.6m (width x height x depth).
    def Cube "ColliderBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
        doc = "Box collider for office-chair: width=0.6m height=0.9m depth=0.6m"
    )
    {
        double3 xformOp:scale = (0.6, 0.9, 0.6)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Xform "RenderMeshPlaceholder" (
        doc = "Render geometry loaded from office-chair.glb — NOT used as collision mesh"
    )
    {
    }
}
